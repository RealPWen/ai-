# Copy to .env.tideos on the server, or inject these through the service manager.
COMPANY_RESEARCH_TIDEOS=true
# Use an absolute path on the target machine, e.g. D:/TideOS/data_hub/company_research
COMPANY_RESEARCH_DATA_ROOT=../../data_hub/company_research
COMPANY_RESEARCH_BASE_PATH=/company-research
# Replace with TideOS's actual public origin (no path or trailing slash).
COMPANY_RESEARCH_PUBLIC_ORIGIN=https://tideos.example.com
BACKEND_PORT=8000
FRONTEND_PORT=8765
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
TUSHARE_TOKEN=
DATABASE_URL=postgresql://YOUR_DB_USER@127.0.0.1:5432/company_research
BACKEND_HTTP_TRANSPORT=native
MARKET_AUTO_UPDATE_ENABLED=false
WATCHLIST_ATTRIBUTION_AUTO_UPDATE_ENABLED=false
RELATION_ATTRIBUTION_AUTO_UPDATE_ENABLED=false
HK_PRICE_PROVIDER=tencent
HK_PRICE_SCOPE=all
HK_FORECAST_SCOPE=all
HK_VALUATION_SCOPE=all
IMA_RESEARCH_ENABLED=true
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# Optional Python with requirements.txt installed; Windows example: D:/Python/python.exe
IMA_PYTHON=
# Optional absolute Tesseract executable; otherwise use the system PATH.
IMA_TESSERACT=
