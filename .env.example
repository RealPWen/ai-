# Backend only. Never copy keys into frontend/config.js.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Backend performs bounded Search API retrieval, then ordinary Responses generation.
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional legacy credentials; ignored when AI_PROVIDER=deepseek.
OPENAI_API_KEY=
TUSHARE_TOKEN=
# Conservative news collector pacing, not a verified account quota or recovery guarantee.
NEWS_TUSHARE_INTERVAL_MS=122000
NEWS_RATE_LIMIT_BACKOFF_MS=3600000
NEWS_NETWORK_RETRY_BASE_MS=5000
NEWS_NETWORK_MAX_RETRY_MS=300000
# Additional retries after the initial failure; 0-10, never unlimited.
NEWS_MAX_RETRIES=3
# The backend updates A, HK and previous-day CLS news at 06:00 Asia/Shanghai.
# Tencent HK prices and Baidu HK valuations need no Tushare token.
MARKET_AUTO_UPDATE_ENABLED=true
# If restarted after 06:00, catch up once; completed days are skipped persistently.
MARKET_AUTO_UPDATE_CATCH_UP=true
# CLS public news uses the same scheduler, its own daily ledger, and no API key.
# Turn off only the news step; MARKET_AUTO_UPDATE_ENABLED=false disables all backend steps.
CLS_NEWS_AUTO_UPDATE_ENABLED=true
# all uses the current HKEX + Tushare hk_basic listed-company catalog.
# pool uses hk-universe.json and also supports eastmoney, yahoo, tushare.
# All-market Tencent prices need no key; the fresh catalog needs TUSHARE_TOKEN.
HK_PRICE_SCOPE=all
HK_PRICE_PROVIDER=tencent
# Daily PE-TTM/PB for current listed HK companies, independently retained one year.
HK_VALUATION_AUTO_UPDATE_ENABLED=true
HK_VALUATION_SCOPE=all
# ETNet current per-broker EPS snapshots, archived daily from first collection.
HK_FORECAST_AUTO_UPDATE_ENABLED=true
# all follows the verified current HK company catalog; pool limits to the workbook.
HK_FORECAST_SCOPE=all
# PostgreSQL market data store (backend/collector only).
DATABASE_URL=postgresql://YOUR_DB_USER@127.0.0.1:5432/company_research
# Optional legacy mode: AI_PROVIDER=chatgpt uses plan sign-in, not OPENAI_API_KEY.
# Leave CHATGPT_MODEL empty to choose from the authorized account catalog.
CHATGPT_MODEL=
BACKEND_PORT=8000
# native (default), or curl for a local network where Node connections reset.
# curl uses the verified system /usr/bin/curl and is currently for macOS/Linux.
BACKEND_HTTP_TRANSPORT=native
# Optional backend proxy. Use the address/port from your own proxy client.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost,::1,api.deepseek.com
# Proxy flag needs Node >=24.5, or >=22.21 in the Node 22 release line.
# Set --use-env-proxy when proxies are configured. If the proxy resets TLS 1.3,
# add --tls-max-v1.2 for this backend; certificate verification stays enabled.
NODE_OPTIONS=

# Core debates: IMA research before web search (credentials may use ~/.config/ima/ files).
IMA_RESEARCH_ENABLED=true
# IMA_OPENAPI_CLIENTID=
# IMA_OPENAPI_APIKEY=
# IMA_PYTHON=/absolute/path/to/python3
# IMA_TESSERACT=/absolute/path/to/tesseract
